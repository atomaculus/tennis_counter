<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF111111"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PLAYCE"
            android:textColor="#FFB8FF2C"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <TextView
            android:id="@+id/widget_last_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No matches yet"
            android:textColor="#FFF5F5F5"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/widget_last_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to start a match"
            android:textColor="#FFB6B6B6"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

    </LinearLayout>

</LinearLayout>
